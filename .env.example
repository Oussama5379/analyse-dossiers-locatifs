# Clé API Groq obligatoire pour l'analyse des documents (https://console.groq.com/)
GROQ_API_KEY=votre_cle_api_groq_ici

# Paramètres Django (optionnels en développement local)
DEBUG=True
SECRET_KEY=changez-moi-en-production
ALLOWED_HOSTS=127.0.0.1,localhost

# Paramètres OCR (optionnels, valeurs par défaut ci-dessous)
OCR_LANGUES=fra+eng
# Chemin vers Tesseract (nécessaire uniquement sur Windows sans Docker)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe